diff --git a/resources/views/livewire/activity-log/index.blade.php b/resources/views/livewire/activity-log/index.blade.php
index 2ea9c722..9e46b23d 100644
--- a/resources/views/livewire/activity-log/index.blade.php
+++ b/resources/views/livewire/activity-log/index.blade.php
@@ -54,7 +54,13 @@ private function getAccessibleUserIds(): array
         $cacheKey = 'activity_log:accessible_users:' . md5(implode(',', $accessibleUnitIds));
 
         return Cache::remember($cacheKey, 300, function () use ($accessibleUnitIds) {
-            return \App\Models\User::whereHas('person', fn($q) => $q->whereIn('u_id', $accessibleUnitIds))
+            // #1057: an access list, not a display list — a soft-deleted user
+            // in scope keeps their audit rows visible. Only the deletion state
+            // is widened; the unit predicate stays exactly as it was, so an
+            // out-of-scope account remains invisible (and 404s in showDetail).
+            return \App\Models\User::query()
+                ->withoutGlobalScope(\Illuminate\Database\Eloquent\SoftDeletingScope::class)
+                ->whereHas('person', fn($q) => $q->whereIn('u_id', $accessibleUnitIds))
                 ->pluck('id')
                 ->toArray();
         });
@@ -65,7 +71,8 @@ public function logs()
     {
         $accessibleUserIds = $this->getAccessibleUserIds();
 
-        $query = ActivityLog::with("user")
+        $query = ActivityLog::query()
+            ->with(['user' => fn ($q) => \App\Support\ActorLabel::eagerLoadActor($q)])
             ->whereIn("user_id", $accessibleUserIds);
 
         if (!empty($this->search)) {
@@ -107,7 +114,7 @@ public function showDetail($id): void
         // whereIn() resolves through Eloquent's `@mixin Query\Builder` and
         // re-types the rest of the chain, and Query\Builder has no findOrFail().
         $this->selectedLog = ActivityLog::query()
-            ->with('user')
+            ->with(['user' => fn ($q) => \App\Support\ActorLabel::eagerLoadActor($q)])
             ->where(function ($query) {
                 $query->whereIn('user_id', $this->getAccessibleUserIds());
             })
@@ -257,7 +264,7 @@ class="input input-bordered input-sm w-36 text-center cursor-pointer" readonly>
             <div class="grid grid-cols-2 gap-4">
                 <div>
                     <span class="text-xs text-base-content/50">کاربر:</span>
-                    <p class="text-sm font-bold">{{ $this->selectedLog->user?->full_name ?? $this->selectedLog->user?->name ?? 'نامشخص' }}</p>
+                    <p class="text-sm font-bold">{{ \App\Support\ActorLabel::for($this->selectedLog->user) }}</p>
                 </div>
                 <div>
                     <span class="text-xs text-base-content/50">نوع:</span>
diff --git a/resources/views/livewire/dashboard.blade.php b/resources/views/livewire/dashboard.blade.php
index 14113bec..7277d86f 100644
--- a/resources/views/livewire/dashboard.blade.php
+++ b/resources/views/livewire/dashboard.blade.php
@@ -163,7 +163,14 @@ public function loadStats(): void
             }
 
             $today = now()->startOfDay()->toDateTimeString();
-            $userIds = User::whereHas('person', fn ($q) => $q->whereIn('u_id', $accessibleIds))
+            // #1057: this is an ACCESS list, not a display list. Soft-deleted
+            // users inside the unit scope keep their audit rows; widening only
+            // the deletion state (never the unit scope) is what keeps the
+            // report complete. Declared `withoutGlobalScope()` — the
+            // `withTrashed()` macro is invisible to PHPStan.
+            $userIds = User::query()
+                ->withoutGlobalScope(\Illuminate\Database\Eloquent\SoftDeletingScope::class)
+                ->whereHas('person', fn ($q) => $q->whereIn('u_id', $accessibleIds))
                 ->orWhereHas('units', fn ($q) => $q->whereIn('units.id', $accessibleIds))
                 ->pluck('id')->toArray();
             $userIdStr = $userIds ? implode(',', $userIds) : '0';
@@ -302,11 +309,15 @@ public function getRecentActivitiesProperty(): \Illuminate\Database\Eloquent\Col
 
         return Cache::remember("dashboard:recent_activities:v{$v}:{$scopeKey}", 120, function () {
             $accessibleIds = app(AccessService::class)->accessibleUnitIds();
-            $userIds = User::whereHas('person', fn ($q) => $q->whereIn('u_id', $accessibleIds))
+            // #1057: include soft-deleted users in scope so their activity
+            // stays in the audit trail; the unit predicate is unchanged.
+            $userIds = User::query()
+                ->withoutGlobalScope(\Illuminate\Database\Eloquent\SoftDeletingScope::class)
+                ->whereHas('person', fn ($q) => $q->whereIn('u_id', $accessibleIds))
                 ->orWhereHas('units', fn ($q) => $q->whereIn('units.id', $accessibleIds))
                 ->pluck('id')->toArray();
 
-            return ActivityLog::with('user')
+            return ActivityLog::with(['user' => fn ($q) => \App\Support\ActorLabel::eagerLoadActor($q)])
                 ->whereIn('user_id', $userIds)
                 ->latest()->take(10)->get();
         });
@@ -637,7 +648,7 @@ public function getZabbixSyncStatusProperty(): array
                 <x-icon name="{{ $icon[0] }}" class="w-5 h-5 {{ $icon[1] }}" />
                 <div class="flex-1 min-w-0">
                     <p class="text-sm truncate">{{ $activity->description }}</p>
-                    <p class="text-[10px] text-base-content/50">{{ $activity->user?->name ?? 'سیستم' }}</p>
+                    <p class="text-[10px] text-base-content/50">{{ \App\Support\ActorLabel::for($activity->user) }}</p>
                 </div>
                 <span class="text-[10px] text-base-content/40 whitespace-nowrap">{{ \Carbon\Carbon::parse($activity->created_at)->diffForHumans() }}</span>
             </div>
